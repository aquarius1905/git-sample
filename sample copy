DELIMITER $$

CREATE PROCEDURE temp_batch_delete()
BEGIN
    DECLARE deleted_count INT DEFAULT 1;
    DECLARE total_deleted INT DEFAULT 0;
    DECLARE batch_num INT DEFAULT 0;
    
    -- 外部キー制約を無効化
    SET FOREIGN_KEY_CHECKS = 0;
    
    
    WHILE deleted_count > 0 DO
        SET batch_num = batch_num + 1;
        
        START TRANSACTION;
        
        DELETE FROM api_access_logs 
        WHERE tenant_id = 69 and access_date <= '2024-05-07' 
        LIMIT 10000;
        
        SET deleted_count = ROW_COUNT();
        SET total_deleted = total_deleted + deleted_count;
        
        COMMIT;
        
        SELECT CONCAT('バッチ ', batch_num, ': ', deleted_count, ' 件削除, 累計: ', total_deleted, ' 件') AS progress;
        
        DO SLEEP(0.1);
        
    END WHILE;
    
    -- 外部キー制約を復元
    SET FOREIGN_KEY_CHECKS = 1;
    
    SELECT CONCAT('削除完了: 総計 ', total_deleted, ' 件') AS result;
    
END$$

CALL temp_batch_delete()$$
DROP PROCEDURE temp_batch_delete$$

DELIMITER ;